# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe commitearse (ya está en .gitignore).

PORT=3000
NODE_ENV=development

# Cadena de conexión a MongoDB. Sin esta variable, en desarrollo se usa
# mongodb://127.0.0.1:27017/qrvey_dev como valor por defecto.
MONGODB=mongodb://usuario:password@host:puerto/basededatos

# Secreto usado para firmar y verificar los JWT. Obligatorio en producción
# (la app no arranca sin él si NODE_ENV=production); usar un valor largo y
# aleatorio, distinto por ambiente.
SECRET_TOKEN=
